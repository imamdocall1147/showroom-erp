# এই ফাইলটা শুধু নমুনা। এটা কপি করে backend ফোল্ডারে ".env" নামে নিজের আসল মান দিয়ে বানান।
# আসল .env ফাইল কখনো GitHub-এ দেবেন না।

# PostgreSQL ডাটাবেসের ঠিকানা: postgresql://ইউজার:পাসওয়ার্ড@হোস্ট:পোর্ট/ডাটাবেসের_নাম
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/showroom_erp

# লগইন টোকেনের গোপন চাবি। লম্বা ও এলোমেলো কিছু দিন (অন্তত ৩২ অক্ষর)
SECRET_KEY=change-this-to-a-long-random-string

# sms_service.py আলাদা কোনো মান (যেমন SMS গেটওয়ের চাবি) চাইলে এখানে ফাঁকা নামটা যোগ করে রাখুন, মান নয়
